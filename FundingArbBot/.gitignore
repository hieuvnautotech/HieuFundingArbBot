## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Oo]bj/
[Bb]in/
[Ll]og/
[Ll]ogs/
artifacts/

# Visual Studio 2022 cache
.vs/

# Visual Studio Code
.vscode/
*.code-workspace

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet
*.nupkg
*.snupkg
# NuGet packages folder
packages/
# NuGet package restore
*.nupkg.sha512
project.lock.json
project.fragment.lock.json
artifacts/

# .NET Core
project.lock.json
project.fragment.lock.json
**/Properties/launchSettings.json
*.deps.json
*.runtimeconfig.json

# Environment files
.env
*.env

# MSBuild
*.pidb
*.svclog
*.dll.config
*.*proj.user

# Rider (JetBrains)
.idea/
*.sln.iml

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# DotCover
*.dcvr
*.dcvrx

# DotTrace
*.dtp
*.dtp[0-9]*

# DotMemory
*.mem
*.mem[0-9]*

# Azure Pipelines
.azure-pipelines.yml

# Logs
*.log
*.tlog

# Others
*.mdb
*.pdb
*.cache
*.sqlite
*.db
*.bak
*.tmp
*.temp
*.swp
*.pid
*.seed
*.orig

# Certificates
*.pfx
*.p12
*.cer
*.crt
*.key

# Sensitive config
secret.json
secrets.json
appsettings.*.local.json
appsettings.Development.json

# Output of coverage tools
coverage.*
*.opencover.xml
TestResults/
*.trx

# Python if you embed scripts
__pycache__/
*.pyc

# Node if tools involved
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# GitHub Copilot temp
.codestream/

# Dump & crash files
*.dmp

# JetBrains tooling
.idea/

# Rider
*.sln.iml

# Local tools
.dotnet-tools.json

# Crash dump
*.dmp

# Backup
*.bak

# Cache
*.cache
.cache/

# Optional: exclude entire config folder (choose if secrets inside)
# config/

